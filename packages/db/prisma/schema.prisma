datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  ADMIN
}

enum TargetTier {
  FAANG
  HIGH_GROWTH_STARTUP
  ENTERPRISE
}

enum TransactionType {
  EARNED
  SPENT
  PENALTY
  STARTER_GRANT
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  fullName      String
  role          Role       @default(CANDIDATE)
  karmaScore    Float      @default(5.0)
  creditBalance Int        @default(2)
  preferredLang String     @default("Java")
  targetTier    TargetTier @default(FAANG)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  creditLedgers           CreditLedger[]
  slotAvailabilities      SlotAvailability[]
  interviewsAsInterviewer InterviewSession[] @relation("InterviewerRelation")
  interviewsAsInterviewee InterviewSession[] @relation("IntervieweeRelation")
  feedbackAuthored        FeedbackRubric[]   @relation("AuthorRelation")
  feedbackReceived        FeedbackRubric[]   @relation("RecipientRelation")

  @@map("users")
}

model CreditLedger {
  id          String          @id @default(uuid())
  userId      String
  amount      Int
  type        TransactionType
  description String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_ledgers")
}

model SlotAvailability {
  id        String   @id @default(uuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  domain    String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startTime, domain, isBooked])
  @@map("slot_availabilities")
}

model InterviewSession {
  id            String        @id @default(uuid())
  interviewerId String
  intervieweeId String
  domain        String
  scheduledAt   DateTime
  status        SessionStatus @default(SCHEDULED)
  roomToken     String        @unique @default(uuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  interviewer User            @relation("InterviewerRelation", fields: [interviewerId], references: [id])
  interviewee User            @relation("IntervieweeRelation", fields: [intervieweeId], references: [id])
  feedback    FeedbackRubric?

  @@index([scheduledAt, status])
  @@map("interview_sessions")
}

model FeedbackRubric {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  authorId        String
  recipientId     String
  techCorrectness Int
  problemSolving  Int
  communication   Int
  codeQuality     Int
  keyStrengths    String
  areasForGrowth  String
  createdAt       DateTime @default(now())

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author    User             @relation("AuthorRelation", fields: [authorId], references: [id])
  recipient User             @relation("RecipientRelation", fields: [recipientId], references: [id])

  @@map("feedback_rubrics")
}
